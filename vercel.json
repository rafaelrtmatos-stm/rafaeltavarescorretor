{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": ".",
  "installCommand": "",
  "framework": null,
  "redirects": [
    {
      "source": "/pajuca",
      "destination": "/pajucara/",
      "permanent": true
    },
    {
      "source": "/pajuca/",
      "destination": "/pajucara/",
      "permanent": true
    },
    {
      "source": "/pajuca/:path*",
      "destination": "/pajucara/:path*",
      "permanent": true
    },
    {
      "source": "/sao-bras",
      "destination": "/sao-braz/",
      "permanent": true
    },
    {
      "source": "/sao-bras/",
      "destination": "/sao-braz/",
      "permanent": true
    },
    {
      "source": "/sao-bras/:path*",
      "destination": "/sao-braz/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/corretores/api/:path*",
      "destination": "/api/corretores?route=:path*"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/corretores?route=auth/:path*"
    },
    {
      "source": "/api/properties",
      "destination": "/api/corretores?route=properties"
    },
    {
      "source": "/api/properties/:path*",
      "destination": "/api/corretores?route=properties/:path*"
    },
    {
      "source": "/api/suggestions",
      "destination": "/api/corretores?route=suggestions"
    },
    {
      "source": "/api/suggestions/:path*",
      "destination": "/api/corretores?route=suggestions/:path*"
    },
    {
      "source": "/api/realtors",
      "destination": "/api/corretores?route=realtors"
    },
    {
      "source": "/api/realtors/:path*",
      "destination": "/api/corretores?route=realtors/:path*"
    }
  ]
}
